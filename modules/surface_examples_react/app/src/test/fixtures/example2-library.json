{
    "resource": "registration.step2",
    "operation": "configure",
    "label": "Configure registration (step 2)",
    "schema": {
        "$schema": "https://portable-schema.dev/v1/schema",
        "$id": "http://localhost/surface-api/registration.step2",
        "title": "Configure registration (step 2)",
        "description": "Sets the event title, whether registration is open, the venue, a room at that venue and a capacity the room can hold.",
        "x-surface": {
            "contract": 5,
            "operation": {
                "id": "configure",
                "label": "Configure registration (step 2)",
                "description": "Sets the event title, whether registration is open, the venue, a room at that venue and a capacity the room can hold.",
                "kind": "update",
                "creates": false,
                "destructive": false,
                "idempotent": true
            },
            "version": 1
        },
        "type": "object",
        "properties": {
            "title": {
                "title": "Event title",
                "type": "string",
                "x-portable-ui": {
                    "widget": "text"
                }
            },
            "open": {
                "title": "Registration open",
                "type": [
                    "boolean",
                    "null"
                ],
                "default": true,
                "x-portable-ui": {
                    "widget": "checkbox"
                }
            },
            "venue": {
                "title": "Venue",
                "type": "string",
                "oneOf": [
                    {
                        "const": "harbour",
                        "title": "Harbour Centre"
                    },
                    {
                        "const": "library",
                        "title": "Old Library"
                    },
                    {
                        "const": "riverside",
                        "title": "Riverside Hall"
                    }
                ],
                "portable-check": {
                    "drupal:SurfaceValidReference": {}
                },
                "x-portable-messages": {
                    "check.drupal:SurfaceValidReference": "Refers to an entity the account may reference"
                },
                "x-portable-ui": {
                    "widget": "select",
                    "options": {
                        "emptyOption": {
                            "show": false,
                            "label": "- Select -"
                        }
                    }
                },
                "x-surface": {
                    "reference": {
                        "entityType": "event_venue"
                    }
                }
            },
            "room": {
                "title": "Room",
                "type": "string",
                "oneOf": [
                    {
                        "const": "library_reading",
                        "title": "Reading room"
                    },
                    {
                        "const": "library_garden",
                        "title": "Garden room"
                    }
                ],
                "x-portable-ui": {
                    "widget": "select",
                    "options": {
                        "emptyOption": {
                            "show": true,
                            "label": "- Select -"
                        }
                    }
                },
                "x-surface": {
                    "dependsOn": [
                        "venue"
                    ],
                    "refined": true,
                    "stale": true
                }
            },
            "capacity": {
                "title": "Capacity",
                "type": [
                    "integer",
                    "null"
                ],
                "minimum": 1,
                "default": 50,
                "x-portable-ui": {
                    "widget": "number"
                },
                "x-surface": {
                    "dependsOn": [
                        "room"
                    ],
                    "enumerated": true
                }
            }
        },
        "additionalProperties": false,
        "required": [
            "title",
            "venue",
            "room"
        ],
        "allOf": [
            {
                "if": {
                    "properties": {
                        "room": {
                            "const": "library_reading"
                        }
                    },
                    "required": [
                        "room"
                    ]
                },
                "then": {
                    "properties": {
                        "capacity": {
                            "type": [
                                "integer",
                                "null"
                            ],
                            "description": "Up to 60 for the Reading room.",
                            "maximum": 60
                        }
                    }
                }
            },
            {
                "if": {
                    "properties": {
                        "room": {
                            "const": "library_garden"
                        }
                    },
                    "required": [
                        "room"
                    ]
                },
                "then": {
                    "properties": {
                        "capacity": {
                            "type": [
                                "integer",
                                "null"
                            ],
                            "description": "Up to 30 for the Garden room.",
                            "maximum": 30
                        }
                    }
                }
            }
        ]
    },
    "values": {
        "title": "Spring meetup",
        "open": true,
        "venue": "library",
        "room": null,
        "capacity": 50
    },
    "stale": [
        "/room"
    ],
    "notes": [
        {
            "path": "/room",
            "code": "stale",
            "message": "The value stored here is no longer available. It is kept until another is chosen: leave this key out, or send it empty with its path in X-Surface-Stale."
        }
    ],
    "discarded": [
        "/room",
        "/capacity"
    ]
}
