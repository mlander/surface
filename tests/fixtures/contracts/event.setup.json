                            "pattern": "Write the date as YYYY-MM-DD, such as 2026-10-17."
                        }
                    },
                    "capacity": {
                        "title": "Capacity",
                        "type": [
                            "integer",
                            "null"
                        ],
                        "minimum": 1,
                        "maximum": 5000,
                        "default": 100
                    },
                    "price": {
                        "title": "Ticket price",
                        "type": [
                            "number",
                            "null"
                        ],
